# Copy to .env and fill in. .env is gitignored, never commit it.

# OpenRouter key. The browser runtime auto-detects the provider from this alone.
OPENROUTER_API_KEY=

# Model the browser agent runs on, as an OpenRouter slug.
# Defaults to anthropic/claude-sonnet-4.5 if unset, which is not a cheap tier.
# Cheaper models were tried and could not hold openJiuwen's structured output
# contract, see notes/first-agent-runs.md.
MODEL_NAME=anthropic/claude-haiku-4.5
