 * 9 October 2026, after it was found missing from the copy made on 18 September.
 *
 * Variant pricing suppressed, for the interaction-gated retrieval experiments.
 *
 * Stock Magento hands the browser every variant price on first load, inside the
 * x-magento-init block, and the configurable widget then renders each option label with
 * its surcharge, "2 x 9.5L +$15.01". Both are readable without any interaction, so the
 * price a shopper asks about is not actually gated in this shop the way it is on the live
 * marketplace, where the DOM holds exactly one price at a time.
 *
 * This template removes both. The price table handed to the widget is flattened to the
 * base price, so no label carries a surcharge and no variant price appears as a figure in
 * the page. The real prices travel in an opaque blob and are written into the price box
 * only for the option actually selected.
 *
 * Stated plainly because it matters for what the results mean: an agent that executes
 * JavaScript of its own could still decode the blob, exactly as an agent on the live
 * marketplace could call the API that page fetches from. What is removed is the price
 * being readable in the observation the agent takes before interacting.
 */
$_product    = $block->getProduct();
$_attributes = $block->decorateArray($block->getAllowAttributes());

$config = json_decode($block->getJsonConfig(), true) ?: [];
$truePrices = $config["optionPrices"] ?? [];

// Flatten every variant to one price. The widget still functions, the selection still
// works, and nothing it renders reveals a price difference.
//
// The figure has to be the one the price box is already showing, not the cheapest variant.
// The widget renders each option label as its price minus `prices.basePrice`, so flattening
// the option table alone leaves a difference for it to print. When a listing had its two
// cheapest sizes sold out, Magento put the cheapest *salable* price on the card and this
// template flattened to the cheapest of all, and every option came out labelled -$3.29.
// Uniform, so it said nothing about any one variant, and still a disclosure: it announced
// that something in the listing costs $3.29 less than the card admits.
//
// So both tables are set to the same number and the rendered difference is exactly zero.
$basePrice = $config["prices"]["finalPrice"]["amount"]
    ?? $config["prices"]["basePrice"]["amount"]
    ?? null;
if ($basePrice === null) {
    foreach ($truePrices as $entry) {
        $candidate = $entry["basePrice"]["amount"] ?? null;
        if ($candidate !== null && ($basePrice === null || $candidate < $basePrice)) {
            $basePrice = $candidate;
        }
    }
}
foreach ($config["optionPrices"] ?? [] as $id => $entry) {
    foreach (["baseOldPrice", "oldPrice", "basePrice", "finalPrice"] as $key) {
        if (isset($config["optionPrices"][$id][$key]["amount"])) {
            $config["optionPrices"][$id][$key]["amount"] = $basePrice;
        }
    }
}
foreach (["baseOldPrice", "oldPrice", "basePrice", "finalPrice"] as $key) {
    if (isset($config["prices"][$key]["amount"])) {
        $config["prices"][$key]["amount"] = $basePrice;
    }
}
$hidden = base64_encode(json_encode($truePrices));
?>
<?php if ($_product->isSaleable() && count($_attributes)) :?>
    <div id="igr-variant-store" data-igr="<?= $block->escapeHtmlAttr($hidden) ?>" hidden="hidden"></div>
    <?php foreach ($_attributes as $_attribute) : ?>
        <div class="field configurable required">
            <label class="label" for="attribute<?= $block->escapeHtmlAttr($_attribute->getAttributeId()) ?>">
                <span><?= $block->escapeHtml($_attribute->getProductAttribute()->getStoreLabel()) ?></span>
            </label>
            <div class="control">
                <select name="super_attribute[<?= $block->escapeHtmlAttr($_attribute->getAttributeId()) ?>]"
                        data-selector="super_attribute[<?= $block->escapeHtmlAttr($_attribute->getAttributeId()) ?>]"
                        data-validate="{required:true}"
                        id="attribute<?= $block->escapeHtmlAttr($_attribute->getAttributeId()) ?>"
                        class="super-attribute-select">
                    <option value=""><?= $block->escapeHtml(__("Choose an Option...")) ?></option>
                </select>
            </div>
        </div>
    <?php endforeach; ?>
    <script type="text/x-magento-init">
        {
            "#product_addtocart_form": {
                "configurable": {
                    "spConfig": <?= /* @noEscape */ json_encode($config) ?>,
                    "gallerySwitchStrategy": "<?= $block->escapeJs($block->getVar(
                        "gallery_switch_strategy",
                        "Magento_ConfigurableProduct"
                    ) ?: "replace"); ?>"
                }
            },
            "*" : {
                "Magento_ConfigurableProduct/js/catalog-add-to-cart": {}
            }
        }
    </script>
    <script>
    (function () {
        var store = document.getElementById("igr-variant-store");
        if (!store) { return; }
        var prices = {};
        try { prices = JSON.parse(atob(store.getAttribute("data-igr"))) || {}; } catch (e) { return; }

        var config = <?= /* @noEscape */ json_encode(["attributes" => $config["attributes"] ?? []]) ?>;

        function chosenProduct() {
            var pools = null;
            var selects = document.querySelectorAll(".super-attribute-select");
            for (var i = 0; i < selects.length; i++) {
                var attributeId = selects[i].id.replace("attribute", "");
                var attribute = config.attributes[attributeId];
                if (!attribute || !selects[i].value) { return null; }
                var matched = null;
                for (var j = 0; j < attribute.options.length; j++) {
                    if (String(attribute.options[j].id) === String(selects[i].value)) {
                        matched = attribute.options[j].products || [];
                    }
                }
                if (!matched) { return null; }
                pools = pools === null ? matched : pools.filter(function (id) {
                    return matched.indexOf(id) !== -1;
                });
            }
            return pools && pools.length === 1 ? pools[0] : null;
        }

        function show() {
            var id = chosenProduct();
            var boxes = document.querySelectorAll(".price-box .price");
            if (!id || !prices[id]) { return; }
            var amount = prices[id].finalPrice ? prices[id].finalPrice.amount : null;
            if (amount === null) { return; }
            var text = "$" + Number(amount).toFixed(2);
            for (var i = 0; i < boxes.length; i++) { boxes[i].textContent = text; }
        }

        document.addEventListener("change", function (event) {
            if (event.target && event.target.classList.contains("super-attribute-select")) {
                setTimeout(show, 60);
            }
        }, true);
    })();
    </script>
<?php endif;?>
