.env
.env.*
!.env.example
*.har
__pycache__/
.venv/
venv/
*.pyc
data/
downloads/
.DS_Store
CLAUDE.md
# Raw agent traces. Each log replays the whole conversation every turn, so a single
# run is hundreds of KB and the results directory reaches hundreds of MB. The tool
# sequence and counts that matter are folded into each run's JSON record by
# experiments/analysis/trace_stats.py, so the logs are reproducible working files, not results.
experiments/**/*.log
.venv-naive/

# Raw marketplace DOM dumps, manual observation only. They carry session identifiers.
docs/shopee_dom.txt
docs/*_dom.txt
*.har

# Presentation decks, mine and the ones I cite. Read in place, not committed.
docs/Huawei Presentation Deck.pdf
OpenJiuwen Web & Coding Agent.pptx
# The openJiuwen paper, arXiv 2608.27969. arXiv's licence lets only arXiv distribute it, so it
# is cited by its id and kept on the laptop.
openjiuwen.pdf

# The verifier's stamp and the spend ledger. Local state that describes one checkout, not results.
.verification/

# openJiuwen writes its own logs to ./logs whenever it is imported, wherever that happens.
/logs/

# Local assistant state, linked worktrees and private submission files.
# Keep worktrees on disk; remove them only through Git after inspecting their changes.
/.claude/
/.codex/
/report/
CLAUDE.history.md
CLAUDE.md.bak-*

# Locally generated review artifacts. These are deliberately separate from raw runs.
/experiments/results/*.sheet.csv
/experiments/results/*.sheet.*.json
/experiments/results/*.second-reader.verdicts.csv
/experiments/results/*.analysis.json
/experiments/results/*.hand.txt
/experiments/results/*.agreement.txt
/experiments/results/*.csv.backup-*
/notes/handover-chatgpt-27-oct.md

# Browser tooling output and editor caches.
/output/playwright/
.pytest_cache/
.ruff_cache/
.vscode/
