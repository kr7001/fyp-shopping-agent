      },
      {
        "code": "a card or sold-out price taken",
        "rule": "the answer states a listing's advertised price, or the price of the question's variant where it is sold out, among the question's product's listings, that the key does not hold as right"
      },
      {
        "code": "a label's figure taken",
        "rule": "the answer states, as a price, a figure a size label shows as a promotion, among the question's product's listings, that the key does not hold as right and that the question does not itself quote; the figure is no price, the size's price shows once it is chosen"
      },
      {
        "code": "other",
        "rule": "anything else"
      }
    ]
