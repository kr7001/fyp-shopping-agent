+def parse_json_object(text: Any) -> dict[str, Any] | None:
+    """Same extraction as ``extract_json_object``, but ``None`` means failure.
+
+    ``extract_json_object`` returns ``{}`` both for text it could not parse and
+    for a payload that really was an empty object, so a caller cannot tell a
+    broken result from an empty one. Probes need that distinction: "no cards on
+    this page" is a valid answer, while "this is not JSON" is a fault, and
+    reporting the first as the second sends the agent into a pointless retry.
+    """
+    parsed = extract_json_object(text)
+    if parsed:
+        return parsed
+    if isinstance(text, dict):
+        return text
+    try:
+        value = json.loads(str(text or "").strip())
+    except (json.JSONDecodeError, TypeError):
+        return None
+    return value if isinstance(value, dict) else None
+
